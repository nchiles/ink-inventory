<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vector Ink Inventory</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/smoothness/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
</head>
<body>
<div class="container">

    <div class="row">
        <div class="col-xl-12">
            <h1>Vector Ink Inventory</h1>
        </div>
    </div>

    <!-- SEARCH INKS -->
    <div class="row">
        <form action="/" method="GET" class="col-lg-2">
            <div class="form-group">
                <input type="text" name="search" placeholder="search..." class="col form-control searchbox">
                <input type="submit" value=">" class="col btn btn-sm btn-primary">
            </div>
        </form>
    </div>    

    <!-- PRESSES -->
    <div class="row">
        <div class="col-xl-12">
            <h3>Inks In Use</h3>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <h5>C218</h5>
        </div>
        <div class="col">
            <h5>C312</h5>
        </div>
        <div class="col">
            <h5>C318</h5>
        </div>
        <div class="col">
            <h5>GA10</h5>
        </div>
        <div class="col">
            <h5>GA18</h5>
        </div>
        <div class="col">
            <h5>SMPL</h5>
        </div>
        <div class="col">
            <h5>SP10</h5>
        </div>
        <div class="col">
            <h5>SP14</h5>
        </div>
    </div> 
</div>
<script src="main.js"></script>  
</body>
</html>


