<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vector Ink Inventory</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/smoothness/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
</head>
<body>
<div class="container">

    <div class="row">
        <div class="col-xl-12">
            <a href="/"><h1>Vector Ink Inventory</h1></a>
        </div>
    </div>

    <!-- SEARCH INKS -->
    <div class="row search-section">
        <form action="/" method="GET" class="col-lg-2">
            <div class="row searchbox">
                <input id="autocompleteInks" type="text" name="search" placeholder="search..." class="col-sm-10 form-control searchbox">
                <input type="submit" value=">" class="col-sm-2 btn btn-sm btn-primary searchsubmit">
            </div>
        </form>
        <div id="searchresults" class="col-lg-10"></div>
    </div>    

    

    <!-- PRESSES -->
    <div class="row">
        <div class="col-xl-12">
            <h3>Inks In Use</h3>
        </div>
    </div>

    <div class="row">
        <div class="col c218-col">
            <h5>C218</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("C218")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>C312</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
