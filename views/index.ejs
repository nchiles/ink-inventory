<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vector Ink Inventory</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/smoothness/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
</head>
<body>
<div class="container">

    <div class="row">
        <div class="col-xl-12">
            <h1><a href="/">Vector Ink Inventory</a></h1>
        </div>
    </div>

    <!-- SEARCH INKS -->
    <div class="row">
        <!-- <form action="/search" method="GET" id="query" class="col-lg-2"> -->
        <form id="query" class="col-lg-2">
            <div class="row form-group">
                <input id="autocompleteInks" type="text" name="search" placeholder="search..." class="col-sm-10 form-control searchbox">
                <input type="submit" value=">" class="col-sm-2 btn btn-sm btn-primary search-button">
            </div>
        </form>
    </div> 
    
    <div class="row">
        <div class="col-lg-2 inkresult"> 
            <% ink.forEach(function(foundink) { %>    
                <div class="col-lg-12 bucket-name"><%= ink.foundink %></div>    
            <% }) %>
        </div>
        <div class="col-lg-2 locationresult"> 
            <% ink.forEach(function(foundlocation) { %>   
                <div class="col-lg-12 bucket-name"><%= ink.foundlocation %></div>    
            <% }) %>    
        </div>  	
        <div class="col-lg-2 idresult"> 
            <% ink.forEach(function(foundid) { %>   
                <div class="col-lg-12 bucket-name"><%= ink.foundid %></div>    
            <% }) %>    
        </div>  
        <form class="col-xl-12" action="/<%= ink._id %>?_method=PUT" method="POST" value="<%= ink.location %>" > 
            <div class=" checkbox-inline press-buttons">
                <label class="btn btn-secondary">
                    <input id="select" class="select-radio" name="ink[location]" type="radio" value="NTMD" ><%= locationArray[0] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-radio" name="ink[location]" type="radio" value="SHLF" ><%= locationArray[1] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C218" ><%= locationArray[2] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C312" ><%= locationArray[3] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C318" ><%= locationArray[4] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="GA10" ><%= locationArray[5] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="GA18" ><%= locationArray[6] %>
                </label>

                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SMPL" ><%= locationArray[7] %>
                </label>
            
                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SP10" ><%= locationArray[8] %>
                </label>

                <label class="btn btn-secondary">
                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SP14" ><%= locationArray[9] %>
                </label>
                
                <button class="btn btn-primary" type="submit">Submit</button>
            </div>
        </form>
    </div>

    <!-- PRESSES -->
    <div class="row">
        <div class="col-xl-12">
            <h3>Inks In Use</h3>
        </div>
    </div>
 
    <div class="row">
        <div class="col c218-col">
            <h5>C218</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("C218")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>C312</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("C312")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>C318</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("C318")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>GA10</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("GA10")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>GA18</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("GA18")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>SMPL</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("SMPL")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>      
        </div>
        <div class="col">
            <h5>SP10</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("SP10")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
        <div class="col">
            <h5>SP14</h5>
            <ul class="sortable">
                <% ink.forEach(function(ink) { %>
                    <% if (ink.location.includes("SP14")) { %>
                        <li class="ui-state-default"><%= ink.ink %></li>
                    <% } %>
                <% }) %>
            </ul>
        </div>
    </div> 
</div>
<script src="main.js"></script>  
</body>
</html>


