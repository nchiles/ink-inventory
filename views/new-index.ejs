<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vector Ink Inventory</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/smoothness/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
</head>
<body>
<div class="container">

    <div class="row">
        <div class="col-xl-12">
            <h1>Vector Ink Inventory</h1>
        </div>
    </div>

    <!-- SEARCH INKS -->
    <div class="row">
        <form action="/" method="GET" class="col-lg-2">
            <div class="ui-widget form-group">
                <input id="autocompleteInks" type="text" name="search" placeholder="search..." class="col form-control searchbox">
                <input type="submit" value=">" class="col btn btn-sm btn-primary">
            </div>
        </form>
       
        <div class="col-lg-10"> 
                <% if(noMatch !== null) { %>
                    <h3><%= noMatch %></h3>
                <% } else { %>
                    <% ink.forEach(function(ink) { %>
                        <form class="" action="/<%= ink._id %>?_method=PUT" method="POST" value="<%= ink.location %>" > 
                            <div class="col bucket-name"><%= ink.ink %></div>
                            <% console.log(ink.location) %>
                            <div class="col checkbox-inline press-buttons">
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-radio" name="ink[location]" type="radio" value="NTMD" <%= ink.location == 'NTMD' ? 'checked' : ''%> ><%= locationArray[0] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-radio" name="ink[location]" type="radio" value="SHLF" <%= ink.location == 'SHLF' ? 'checked' : ''%> ><%= locationArray[1] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C218" <%= ink.location.includes('C218') ? 'checked' : ''%> ><%= locationArray[2] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C312" <%= ink.location.includes('C312') ? 'checked' : ''%> ><%= locationArray[3] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="C318" <%= ink.location.includes('C318') ? 'checked' : ''%> ><%= locationArray[4] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="GA10" <%= ink.location.includes('GA10') ? 'checked' : ''%> ><%= locationArray[5] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="GA18" <%= ink.location.includes('GA18') ? 'checked' : ''%> ><%= locationArray[6] %>
                                </label>

                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SMPL" <%= ink.location.includes('SMPL') ? 'checked' : ''%> ><%= locationArray[7] %>
                                </label>
                            
                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SP10" <%= ink.location.includes('SP10') ? 'checked' : ''%> ><%= locationArray[8] %>
                                </label>

                                <label class="btn btn-sm btn-secondary">
                                    <input id="select" class="select-checkbox" name="ink[location]" type="checkbox" value="SP14" <%= ink.location.includes('SP14') ? 'checked' : ''%> ><%= locationArray[9] %>
                                </label>
                                
                                <button class="btn btn-sm btn-primary" type="submit">Submit</button>
                            </div>
                        </form>
                <% }) %>
            <% }; %>
        </div>  	
    </div>    

    <!-- PRESSES -->
    <div class="row">
        <div class="col-xl-12">
            <h3>Inks In Use</h3>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <h5>C218</h5>
        </div>
        <div class="col">
            <h5>C312</h5>
        </div>
        <div class="col">
            <h5>C318</h5>
        </div>
        <div class="col">
            <h5>GA10</h5>
        </div>
        <div class="col">
            <h5>GA18</h5>
        </div>
        <div class="col">
            <h5>SMPL</h5>
        </div>
        <div class="col">
            <h5>SP10</h5>
        </div>
        <div class="col">
            <h5>SP14</h5>
        </div>
    </div> 
</div>
<script src="main.js"></script>  
</body>
</html>


